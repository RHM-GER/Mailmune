{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mailmune",
  "version": "0.1.0",
  "identifier": "de.rhmedia.mailmune",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm run prepare:sidecar && pnpm dev",
    "beforeBuildCommand": "pnpm run prepare:sidecar && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Mailmune",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/spam-agent"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
