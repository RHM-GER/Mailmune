{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mailmune.local/contracts/v1/types.schema.json",
  "title": "Mailmune API v1",
  "description": "Versionierte Vertragstypen der lokalen Mailmune-API. Fehlerantworten tragen immer einen stabilen Code und einen redigierten Text. Es gibt keine Endpunkte zum Löschen von E-Mails.",
  "type": "object",
  "$defs": {
    "Error": {
      "type": "object",
      "required": ["error", "code"],
      "properties": {
        "error": { "type": "string" },
        "code": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "required": ["group", "code", "weight", "summary"],
      "properties": {
        "group": { "type": "string" },
        "code": { "type": "string" },
        "weight": { "type": "number", "minimum": -1, "maximum": 1 },
        "summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "SafetyMode": {
      "enum": ["confirm_all", "safe", "aggressive"]
    },
    "MailboxProfile": {
      "type": "object",
      "required": ["purpose", "industry", "context", "unexpected", "languages", "expectedMailTypes", "trustedDomains", "trustedSenders", "wantedNewsletters", "legitimateAutomated"],
      "properties": {
        "purpose": { "type": "string" },
        "industry": { "type": "string" },
        "context": { "type": "string", "description": "Freitext des Besitzers: ungewöhnliche, aber legitime Mails und Besonderheiten. Hauptquelle der KI-Profilkompilierung." },
        "unexpected": { "type": "string", "description": "Klartext: was dieses Postfach NIEMALS erwartet. Quelle der KI-abgeleiteten Fremdkampagnen." },
        "languages": { "type": "array", "items": { "type": "string" } },
        "expectedMailTypes": { "type": "array", "items": { "type": "string" } },
        "trustedDomains": { "type": "array", "items": { "type": "string" } },
        "trustedSenders": { "type": "array", "items": { "type": "string" } },
        "deniedSenders": { "type": "array", "items": { "type": "string" } },
        "deniedDomains": { "type": "array", "items": { "type": "string" } },
        "deniedKeywords": { "type": "array", "items": { "type": "string" } },
        "wantedNewsletters": { "type": "array", "items": { "type": "string" } },
        "legitimateAutomated": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "Account": {
      "type": "object",
      "required": ["id", "name", "host", "port", "username", "secretRef", "inboxFolder", "sentFolder", "spamFolder", "safetyMode", "ollamaValidated", "aiEnabled", "enabled", "dryRun", "deepScan", "deepScanWeekday", "deepScanHour", "createdAt", "updatedAt", "profile"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "username": { "type": "string" },
        "secretRef": { "type": "string", "description": "Referenz in den Betriebssystem-Schlüsselbund; niemals das Passwort selbst." },
        "inboxFolder": { "type": "string" },
        "sentFolder": { "type": "string" },
        "spamFolder": { "type": "string" },
        "safetyMode": { "$ref": "#/$defs/SafetyMode" },
        "ollamaModel": { "type": "string" },
        "ollamaValidated": { "type": "boolean" },
        "aiEnabled": { "type": "boolean", "description": "KI-Hauptschalter des Postfachs: Aus = nur Regeln/Lernfilter, An = das validierte lokale Modell prueft mit und die Desktop-App haelt Ollama am Laufen." },
        "enabled": { "type": "boolean" },
        "dryRun": { "type": "boolean", "description": "Neue Konten sind immer true; automatische Aktionen erfordern eine spätere ausdrückliche Änderung." },
        "deepScan": { "type": "boolean", "description": "Aktiviert den wöchentlichen KI-Tiefscan; ohne dieses Flag sind Wochentag/Stunde bedeutungslos." },
        "deepScanWeekday": { "type": "integer", "minimum": -1, "maximum": 6, "description": "Wochentag des wöchentlichen KI-Tiefscans in lokaler Zeit (0=Sonntag..6=Samstag); -1 deaktiviert." },
        "deepScanHour": { "type": "integer", "minimum": -1, "maximum": 23, "description": "Stunde des wöchentlichen KI-Tiefscans in lokaler Zeit (0..23); -1 deaktiviert." },
        "lastDeepScanAt": { "type": "string", "format": "date-time", "description": "Letzter erfolgreicher Tiefscan; begrenzt das Fenster des nächsten." },
        "lastScanAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "profile": { "$ref": "#/$defs/MailboxProfile" }
      },
      "additionalProperties": false
    },
    "ConnectionInfo": {
      "type": "object",
      "required": ["folders", "supportsIdle", "supportsMove"],
      "properties": {
        "folders": { "type": "array", "items": { "type": "string" } },
        "supportsIdle": { "type": "boolean" },
        "supportsMove": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "ScanStatus": {
      "enum": ["running", "completed", "cancelled", "failed", "interrupted"]
    },
    "ScanRun": {
      "type": "object",
      "required": ["id", "accountId", "status", "folder", "processed", "estimatedTotal", "startedAt", "updatedAt"],
      "properties": {
        "id": { "type": "string" },
        "accountId": { "type": "string" },
        "status": { "$ref": "#/$defs/ScanStatus" },
        "folder": { "type": "string" },
        "processed": { "type": "integer", "minimum": 0 },
        "estimatedTotal": { "type": "integer", "minimum": 0 },
        "startedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "error": { "type": "string", "description": "Redigierte, nutzerfreundliche Fehlermeldung ohne Geheimnisse." }
      },
      "additionalProperties": false
    },
    "ScanEvent": {
      "type": "object",
      "required": ["run"],
      "properties": {
        "run": { "$ref": "#/$defs/ScanRun" },
        "candidates": { "type": "integer", "minimum": 0 },
        "moved": { "type": "integer", "minimum": 0 },
        "folderMessages": { "type": "integer", "minimum": 0", "description": "Exakte Nachrichtenanzahl des gescannten Ordners; erklärt begrenzte Erstläufe." },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "MessageDecision": {
      "type": "object",
      "required": ["id", "accountId", "originFolder", "score", "status", "evidence", "receivedAt"],
      "properties": {
        "id": { "type": "string" },
        "accountId": { "type": "string" },
        "originFolder": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "enum": ["pending", "moved", "confirmed", "rejected", "deferred"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/Evidence" } },
        "receivedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Summary": {
      "type": "object",
      "required": ["accounts", "pending", "moved", "confirmed", "rejected", "falsePositiveRate", "processedWeek", "scanned"],
      "properties": {
        "accounts": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "moved": { "type": "integer", "minimum": 0 },
        "confirmed": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "falsePositiveRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "processedWeek": { "type": "integer", "minimum": 0 },
        "scanned": { "type": "integer", "minimum": 0, "description": "Einmalig klassifizierte Nachrichten gesamt (dedupliziert; ein Rescan zählt nicht doppelt)" }
      },
      "additionalProperties": false
    },
    "EventStream": {
      "description": "SSE-Ereignisse unter GET /v1/events. Ereignistypen: ready, heartbeat, scan.started, scan.progress, scan.finished, account.updated, model.validated, baseline.updated, baseline.deleted, move.completed.",
      "type": "string"
    },
    "RecommendedModel": {
      "type": "object",
      "required": ["tag", "label", "sizeClass", "rationale", "default"],
      "properties": {
        "tag": { "type": "string" },
        "label": { "type": "string" },
        "sizeClass": { "type": "string" },
        "rationale": { "type": "string" },
        "default": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "ModelRecommendations": {
      "type": "object",
      "required": ["version", "models"],
      "properties": {
        "version": { "type": "string" },
        "models": { "type": "array", "items": { "$ref": "#/$defs/RecommendedModel" } }
      },
      "additionalProperties": false
    },
    "CapabilityReport": {
      "type": "object",
      "required": ["model", "promptVersion", "passed", "cases"],
      "properties": {
        "model": { "type": "string" },
        "promptVersion": { "type": "string" },
        "passed": { "type": "boolean" },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "valid", "expectedClass"],
            "properties": {
              "name": { "type": "string" },
              "valid": { "type": "boolean" },
              "expectedClass": { "type": "string" },
              "classification": { "type": "string" },
              "error": { "type": "string" }
            }
          }
        }
      }
    },
    "LearningBaseline": {
      "type": "object",
      "required": ["id", "version", "source", "license", "corpusRows", "spamMessages", "hamMessages", "importedAt"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "integer" },
        "source": { "type": "string", "description": "Herkunft des Korpus (Name/URL) – dokumentierte Pflichtangabe." },
        "license": { "type": "string", "description": "Lizenz des Korpus, z. B. MIT." },
        "corpusRows": { "type": "integer", "minimum": 0 },
        "spamMessages": { "type": "integer", "minimum": 0 },
        "hamMessages": { "type": "integer", "minimum": 0 },
        "importedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "MoveDirection": {
      "enum": ["to_spam", "restore"]
    },
    "MoveState": {
      "enum": ["planned", "moving", "moved", "confirmed", "restoring", "restored", "failed_retryable", "failed_terminal"]
    },
    "MoveOperation": {
      "description": "Einzelner absturzfest idempotenter IMAP-MOVE. Es gibt ausschliesslich atomares UID MOVE in den Spam-Ordner und Restore zurueck; niemals ein Loeschen.",
      "type": "object",
      "required": ["id", "accountId", "direction", "originFolder", "originUid", "originUidValidity", "targetFolder", "state", "attempts", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "description": "Idempotenzschluessel; ein wiederholter Plan erzeugt nie eine zweite Bewegung." },
        "accountId": { "type": "string" },
        "decisionId": { "type": "string" },
        "direction": { "$ref": "#/$defs/MoveDirection" },
        "originFolder": { "type": "string" },
        "originUid": { "type": "integer", "minimum": 0 },
        "originUidValidity": { "type": "integer", "minimum": 0 },
        "targetFolder": { "type": "string" },
        "state": { "$ref": "#/$defs/MoveState" },
        "destUid": { "type": "integer", "minimum": 0 },
        "destUidValidity": { "type": "integer", "minimum": 0 },
        "messageIdHash": { "type": "string" },
        "attempts": { "type": "integer", "minimum": 0 },
        "lastError": { "type": "string", "description": "Redigierte Fehlermeldung ohne Geheimnisse." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "ThresholdMetric": {
      "type": "object",
      "required": ["threshold", "tp", "fp", "tn", "fn", "precision", "recall", "fpr"],
      "properties": {
        "threshold": { "type": "number" },
        "tp": { "type": "integer", "minimum": 0 },
        "fp": { "type": "integer", "minimum": 0 },
        "tn": { "type": "integer", "minimum": 0 },
        "fn": { "type": "integer", "minimum": 0 },
        "precision": { "type": "number", "minimum": 0, "maximum": 1 },
        "recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "fpr": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "CalibrationBucket": {
      "type": "object",
      "required": ["lower", "upper", "count", "meanScore", "spamRate"],
      "properties": {
        "lower": { "type": "number" },
        "upper": { "type": "number" },
        "count": { "type": "integer", "minimum": 0 },
        "meanScore": { "type": "number" },
        "spamRate": { "type": "number" }
      },
      "additionalProperties": false
    },
    "CalibrationReport": {
      "description": "Qualitaet des Filters gemessen an menschlich bestaetigten Reviews. autoMoveReady ist true, wenn die Praezision am Auto-Move-Threshold (0.98) auf einer ausreichenden Stichprobe mindestens 99.5 Prozent betraegt.",
      "type": "object",
      "required": ["accountId", "reviewed", "confirmed", "rejected", "thresholds", "buckets", "autoMoveReady"],
      "properties": {
        "accountId": { "type": "string" },
        "reviewed": { "type": "integer", "minimum": 0 },
        "confirmed": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "thresholds": { "type": "array", "items": { "$ref": "#/$defs/ThresholdMetric" } },
        "buckets": { "type": "array", "items": { "$ref": "#/$defs/CalibrationBucket" } },
        "autoMoveReady": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "DailyStat": {
      "description": "Ein Tag aggregierter Aktivitaet ueber alle Konten; fuellt die Dashboard-Charts mit echten Daten.",
      "type": "object",
      "required": ["day", "processed", "moved", "confirmed", "rejected", "missed"],
      "properties": {
        "day": { "type": "string", "description": "Tag im Format YYYY-MM-DD (UTC)." },
        "processed": { "type": "integer", "minimum": 0 },
        "moved": { "type": "integer", "minimum": 0 },
        "confirmed": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "missed": { "type": "integer", "minimum": 0, "description": "Nicht erkannt: Spam, den ein Mensch oder Fremdfilter einsortiert hat, obwohl Mailmune ihn nicht flaggte." }
      },
      "additionalProperties": false
    },
    "ProfileIndicators": {
      "description": "KI-kompilierte Indikator-Sets pro Postfach: Erwartungsthemen (senken den Score) und profilspezifische Fremdkampagnen (heben ihn). Nur Literal-Terme, strikt begrenzt, bei der Kompilierung validiert.",
      "type": "object",
      "properties": {
        "expectedTopics": { "type": "array", "maxItems": 24, "items": { "type": "string", "minLength": 2, "maxLength": 40 } },
        "unexpectedTopics": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["name", "terms"],
            "properties": {
              "name": { "type": "string", "maxLength": 60 },
              "terms": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "type": "string", "minLength": 2, "maxLength": 40 } }
            },
            "additionalProperties": false
          }
        },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "additionalProperties": false
    },
    "ProfileModel": {
      "description": "Persistiertes Ergebnis der KI-Profilkompilierung: Prompt fuer das lokale Modell plus Indikatoren fuer die deterministischen Regeln. sourceHash markiert Veraltung nach Profiltext-Aenderungen.",
      "type": "object",
      "required": ["accountId", "sourceHash", "compiledAt", "model", "prompt", "indicators", "enabled"],
      "properties": {
        "accountId": { "type": "string" },
        "sourceHash": { "type": "string" },
        "compiledAt": { "type": "string" },
        "model": { "type": "string" },
        "prompt": { "type": "string", "maxLength": 4000 },
        "indicators": { "$ref": "#/$defs/ProfileIndicators" },
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "ProfileModelResponse": {
      "description": "Antwort von GET /v1/accounts/{id}/profile/model: model ist null, wenn noch nie kompiliert wurde; stale=true means Profiltext und Kompilat passen nicht mehr zusammen.",
      "type": "object",
      "required": ["model", "stale", "inUse"],
      "properties": {
        "model": { "oneOf": [{ "$ref": "#/$defs/ProfileModel" }, { "type": "null" }] },
        "stale": { "type": "boolean" },
        "inUse": { "type": "boolean", "description": "true = Kompilat existiert, ist eingeschaltet und passt zum aktuellen Profiltext (Indikatoren + Prompt sind im Scan aktiv)." }
      },
      "additionalProperties": false
    },
    "LearningBaseline": {
      "description": "Metadaten der optionalen globalen Lern-Baseline (externes Korpus, opt-in).",
      "type": "object",
      "required": ["id", "version", "source", "license", "corpusRows", "spamMessages", "hamMessages", "importedAt"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "source": { "type": "string", "description": "Herkunft (Name/URL des Korpus)." },
        "license": { "type": "string" },
        "corpusRows": { "type": "integer", "minimum": 0 },
        "spamMessages": { "type": "integer", "minimum": 0 },
        "hamMessages": { "type": "integer", "minimum": 0 },
        "importedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "BaselineResponse": {
      "type": "object",
      "required": ["baseline"],
      "properties": {
        "baseline": { "oneOf": [{ "$ref": "#/$defs/LearningBaseline" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "TransferExport": {
      "description": "Portables Export-Dokument fuer Lern-/Profiltransfer auf einen anderen Rechner. Learning enthaelt nur Token-Zaehlstaende des statistischen Lerners (keine Rohtexte); beim Profiltransfer kommt das Mailbox-Profil dazu.",
      "type": "object",
      "required": ["app", "kind", "version", "exportedAt", "account"],
      "properties": {
        "app": { "type": "string", "const": "mailmune" },
        "kind": { "type": "string", "enum": ["learning", "profile"] },
        "version": { "type": "integer", "minimum": 1 },
        "exportedAt": { "type": "string", "description": "RFC3339-Zeitstempel (UTC)." },
        "account": { "type": "string", "description": "Anzeigename des Quellpostfachs." },
        "profile": { "$ref": "#/$defs/MailboxProfile" },
        "learning": { "type": "object", "description": "Serialisierter learning.Model (version, spamCounts, hamCounts, spamTokens, hamTokens, spamMessages, hamMessages)." }
      },
      "additionalProperties": false
    }
  }
}
